#!/bin/sh
### BEGIN INIT INFO
# Provides:          zigbee2mqtt
# Required-Start:    $remote_fs $syslog $network mosquitto
# Required-Stop:     $remote_fs $syslog $network
# Default-Start:     3 4 5
# Default-Stop:      0 1 2 6
# Short-Description: Zigbee2MQTT portable bundle
### END INIT INFO

APP_DIR="/opt/zigbee2mqtt"
DAEMON="$APP_DIR/zigbee2mqtt"
PIDFILE="/var/run/zigbee2mqtt.pid"
LOGFILE="/var/log/zigbee2mqtt.log"

start() {
    echo "Starting Zigbee2MQTT..."
    [ -x "$DAEMON" ] || { echo "Not executable: $DAEMON"; exit 1; }
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$LOGFILE")"
    cd "$APP_DIR" || exit 1
    # Optional: raise file descriptors for many devices
    ulimit -n 4096 2>/dev/null

    # Run in background and capture PID
    "$DAEMON" >>"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    echo "Started, pid $(cat "$PIDFILE")"
}

stop() {
    echo "Stopping Zigbee2MQTT..."
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        sleep 1
        # Force kill if still alive
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            kill -9 "$(cat "$PIDFILE")" 2>/dev/null || true
        fi
        rm -f "$PIDFILE"
        echo "Stopped."
    else
        echo "Not running."
    fi
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "Zigbee2MQTT running, pid $(cat "$PIDFILE")"
        exit 0
    else
        echo "Zigbee2MQTT not running"
        exit 1
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac